# Copy to repo root as .env when using Docker Compose stacks.
#
# UModel + Memgraph:
#   COMPOSE_PROFILES=memgraph
#   GRAPHSTORE=remote.memgraph
#
# UModel + Neo4j:
#   COMPOSE_PROFILES=neo4j
#   GRAPHSTORE=remote.neo4j
#
# Then run: docker compose -f deployments/compose/docker-compose.yaml up --build

COMPOSE_FILE=deployments/compose/docker-compose.yaml
GRAPHSTORE=file.memory
NEO4J_PASSWORD=itree.123456
UMODEL_API_PORT=18080
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
MEMGRAPH_BOLT_PORT=7688

# COMPOSE_PROFILES=memgraph
# GRAPHSTORE=remote.memgraph
